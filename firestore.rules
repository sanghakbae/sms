rules_version = '2';

// 영업 관리시스템 — 로그인(Google, 이메일 인증됨)한 계정이면 접근할 수 있다.
// 거래처·영업기회·활동은 팀 전체가 함께 보되(파이프라인·실적을 공유하므로),
// 수정·삭제는 담당자 본인 또는 팀장(admin)만 가능하다.
// 월 매출목표 설정은 팀장만 할 수 있다.
service cloud.firestore {
  match /databases/{database}/documents {

    function email() {
      return request.auth != null ? request.auth.token.email : '';
    }

    // src/lib/accounts.js 의 ALLOWED_DOMAINS·ADMIN_EMAILS 와 반드시 같게 유지할 것.
    // 도메인 제한 없음 — 이메일이 인증된 Google 계정이면 팀원으로 인정한다.
    // 특정 도메인만 허용하려면 accounts.js 의 ALLOWED_DOMAINS 와 함께
    // 아래 조건에 email().matches('.*@example[.]com') 형태를 다시 추가한다.
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && email() != '';
    }

    // src/lib/accounts.js 의 BOOTSTRAP_ADMINS 와 반드시 같게 유지할 것.
    // 명단을 잘못 비워 아무도 못 들어가는 상황을 막는 안전장치라 화면에서 지울 수 없다.
    function bootstrapAdmins() {
      return ['qa@muhayu.com', 'totoriverce@tukorea.ac.kr'];
    }

    // 화면에서 추가한 관리자 명단(settings/admins). 문서가 없으면 빈 목록.
    function rosterAdmins() {
      return exists(/databases/$(database)/documents/settings/admins)
        ? get(/databases/$(database)/documents/settings/admins).data.get('emails', [])
        : [];
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (email() in bootstrapAdmins() || email() in rosterAdmins());
    }

    // 담당자(owner) 변경은 관리자만 할 수 있다.
    // 일반 팀원은 자기 딜을 수정할 수는 있어도 남에게 넘길 수는 없다.
    function ownerUnchangedOrAdmin() {
      return request.resource.data.owner == resource.data.owner || isAdmin();
    }

    // 담당자 본인 또는 팀장만 손댈 수 있다.
    function ownsOrAdmin() {
      return resource.data.owner == request.auth.uid || isAdmin();
    }

    match /customers/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if isMember() && ownsOrAdmin() && ownerUnchangedOrAdmin();
      allow delete: if isMember() && ownsOrAdmin();
    }

    match /deals/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0;
      allow update: if isMember() && ownsOrAdmin() && ownerUnchangedOrAdmin();
      allow delete: if isMember() && ownsOrAdmin();
    }

    match /activities/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.owner == request.auth.uid;
      allow update: if isMember() && ownsOrAdmin() && ownerUnchangedOrAdmin();
      allow delete: if isMember() && ownsOrAdmin();
    }

    // settings/targets — 월별 매출목표 { 'YYYY-MM': 금액 }. 설정은 팀장만.
    match /settings/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
